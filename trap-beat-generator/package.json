{
  "name": "trap-beat-generator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Trap Beat Generator - PWA che genera basi trap esportabili in MIDI per FL Studio",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test": "node scripts/run-tests.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tone": "^15.1.22",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "esbuild": "^0.28.0"
  }
}
