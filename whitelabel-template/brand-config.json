    "provider": "gemini",
    "model": "gemini-2.5-flash-lite",
    "temperature": 0.2,
    "timeoutMs": 45000,
    "retries": 2,
    "endpoint": "/api/gemini",
    "systemPromptSuffix": ""
  },

  "ocr": {
    "provider": "gemini",
    "language": "it",
    "autoCrop": true,
    "quality": "high",
    "minConfidence": 0.6
