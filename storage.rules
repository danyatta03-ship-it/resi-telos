rules_version = '2';

// Regole Firebase Storage — Portale Tracking Resi.
// Applicare da Firebase Console -> Storage -> Regole.
//
// Struttura dei path:
//   portal/returns/<returnKey>/<docId>_<filename>   documenti allegati a un reso
//   portal/requests/<reqId>/<docId>_<filename>      allegati richiesta ritiro
//   portal/brand/<filename>                          logo white-label (solo ADMIN)
//
// L'autorizzazione fine (quale utente vede quale reso) e' nel Realtime Database:
// Storage non puo' interrogare RTDB, quindi qui applichiamo i controlli che
// Storage sa fare da solo — ruolo dal custom claim, dimensione, content-type —
// e teniamo l'URL di download non indovinabile (docId casuale).
// I metadati in portal_documents/<returnKey> restano la fonte di verita' su
// chi puo' ELENCARE i file: senza quella riga il path non e' scopribile.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function prole() {
      return request.auth.token.prole;
    }

    function isStaff() {
      return signedIn() && (prole() == 'ADMIN' || prole() == 'TELOS');
    }

    function knownRole() {
      return signedIn() && prole() in ['ADMIN', 'TELOS', 'CLIENTE', 'AGENTE', 'CORRIERE'];
    }

    // Tipi ammessi: immagini (foto pacco/bolla) e PDF (documenti).
    function allowedType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)')
          || request.resource.contentType == 'application/pdf';
    }

    function underSizeLimit() {
      return request.resource.size <= 15 * 1024 * 1024;
    }

    match /portal/returns/{returnKey}/{fileName} {
      allow read:   if knownRole();
      allow create: if knownRole() && allowedType() && underSizeLimit();
      // Nessun update: i file sono immutabili una volta caricati (audit trail).
      allow update: if false;
      allow delete: if isStaff();
    }

    match /portal/requests/{reqId}/{fileName} {
      allow read:   if knownRole();
      allow create: if knownRole() && allowedType() && underSizeLimit();
      allow update: if false;
      allow delete: if isStaff();
    }

    match /portal/brand/{fileName} {
      allow read:   if true;
      allow write:  if signedIn() && prole() == 'ADMIN'
                    && request.resource.contentType.matches('image/.*')
                    && request.resource.size <= 2 * 1024 * 1024;
    }

    // Tutto il resto e' negato.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
