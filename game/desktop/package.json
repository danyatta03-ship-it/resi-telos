{
  "name": "realwar-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "REALWAR Roma — desktop build",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.realwar.roma",
    "productName": "REALWAR Roma",
    "asar": true,
    "files": [
      "main.js"
    ],
    "extraResources": [
      { "from": "../play.html", "to": "game/play.html" }
    ],
    "win": {
      "target": ["portable"],
      "artifactName": "REALWAR-Roma-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
